{
  "name": "Lumen Cells",
  "short_name": "Lumen Cells",
  "description": "Spreadsheets for .xlsx workbooks",
  "start_url": "./index.html",
  "scope": "./",
  "id": "./index.html",
  "display": "standalone",
  "background_color": "#f3f3f3",
  "theme_color": "#217346",
  "icons": [
    {
      "src": "../icons/cells-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "../icons/cells-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    }
  ],
  "file_handlers": [
    {
      "action": "./index.html",
      "accept": {
        "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet": [
          ".xlsx"
        ],
        "text/csv": [
          ".csv"
        ]
      }
    }
  ],
  "launch_handler": {
    "client_mode": "navigate-new"
  }
}